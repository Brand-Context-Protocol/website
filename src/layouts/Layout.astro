---
import "../styles/global.css";
const metadata = Astro.props.frontmatter ?? Astro.props;
const { title = "Brand Context Protocol", description = "The open specification for machine-readable brand context." } = metadata;
const canonicalPath = Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/$/, "");
const canonical = new URL(canonicalPath, Astro.site ?? Astro.url.origin).href;
const pageTitle = title === "Home" ? "Brand Context Protocol" : `${title} | Brand Context Protocol`;
const noIndex = title === "Not Found";
const isCurrentSpec = /^\/spec\/v1\.1\.0\/?$/.test(Astro.url.pathname);
const isProtocolHome = Astro.url.pathname === "/";
const isNotFound = title === "Not Found";
const isVerificationGuide = /^\/registry-verification\/?$/.test(Astro.url.pathname);
const isKeyLifecycleGuide = /^\/registry-key-lifecycle\/?$/.test(Astro.url.pathname);
const isProtocolGuide = isVerificationGuide || isKeyLifecycleGuide;
const isSchemaReference = /^\/schema\/?$/.test(Astro.url.pathname);
const isArchivedSpec = /^\/spec\/v0\.\d+\/?$/.test(Astro.url.pathname);
const isProtocolReference = isSchemaReference || isArchivedSpec;
const hasProtocolChrome = isCurrentSpec || isProtocolHome || isNotFound || isProtocolGuide || isProtocolReference;
const specSections = [
    ["Abstract", "abstract"],
    ["Change log", "change-log"],
    ["01 · Introduction", "1-introduction"],
    ["02 · Terminology", "2-terminology"],
    ["03 · Architecture", "3-architecture-overview"],
    ["04 · File format", "4-file-format"],
    ["05 · Publishing", "5-publishing-a-bcp"],
    ["06 · Resolution", "6-hierarchical-resolution"],
    ["07 · File tree", "7-the-file-tree"],
    ["08 · Versioning", "8-versioning"],
    ["09 · Taxonomies", "9-content-taxonomies"],
    ["10 · Representation", "10-representation"],
    ["11 · Localization", "11-localization"],
    ["12 · Privacy and access", "12-privacy-access-control-and-authentication"],
    ["13 · Consumer ergonomics", "13-consumer-ergonomics"],
    ["14 · Producer ergonomics", "14-producer-ergonomics"],
    ["15 · Security", "15-security-considerations"],
    ["16 · Conformance", "16-conformance"],
    ["17 · Future work", "17-open-questions-and-future-work"],
    ["18 · Appendices", "18-appendices"],
] as const;
const structuredData = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "WebSite",
            "@id": "https://brandcontextprotocol.dev/#website",
            name: "Brand Context Protocol",
            url: "https://brandcontextprotocol.dev/",
            description: "The open specification for machine-readable brand context.",
        },
        {
            "@type": Astro.url.pathname.startsWith("/spec/") ? "TechArticle" : "WebPage",
            name: pageTitle,
            description,
            url: canonical,
            isPartOf: { "@id": "https://brandcontextprotocol.dev/#website" },
        },
    ],
};
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex,follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/Aeonik-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="alternate" type="text/markdown" href="https://brandcontextprotocol.dev/.well-known/brand.md" title="Brand Context Protocol BCP" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body class:list={{ "current-spec": isCurrentSpec, "protocol-home": isProtocolHome, "protocol-not-found": isNotFound, "protocol-guide": isProtocolGuide || isProtocolReference, "protocol-reference": isProtocolReference, "protocol-schema": isSchemaReference, "protocol-archive": isArchivedSpec, "protocol-key-lifecycle": isKeyLifecycleGuide }}>
    <nav aria-label="Primary navigation">
        {hasProtocolChrome && <a class="spec-wordmark" href="/" aria-label="Brand Context Protocol home"><img src="/brand-mark.svg" alt="Encoded Brands logomark" width="31" height="36" /><span>Brand Context<br />Protocol</span></a>}
        <div class="nav-links">
            <a href="/" aria-current={isProtocolHome ? "page" : undefined}>{hasProtocolChrome ? "Home" : "[ Home ]"}</a>
            <a href="/spec">{hasProtocolChrome ? "Specification" : "[ Spec ]"}</a>
            <a href="/schema" aria-current={isSchemaReference ? "page" : undefined}>{hasProtocolChrome ? "Schemas" : "[ Schema ]"}</a>
            <a href="/registry-verification" aria-current={isVerificationGuide ? "page" : undefined}>{hasProtocolChrome ? "Verify Registry" : "[ Verify Registry ]"}</a>
            <a href="https://github.com/Brand-Context-Protocol/spec">{hasProtocolChrome ? "GitHub ↗" : "[ GitHub ]"}</a>
        </div>
    </nav>
    <main>
        {isCurrentSpec && <div class="spec-banner" aria-label="Specification status"><div class="spec-banner-main"><span>Specification</span><strong>v1.1.0</strong></div><div class="spec-banner-bottom"><span>Draft · 23 September 2026</span><span>CC BY 4.0</span></div></div>}
        <div class:list={{ "spec-layout": isCurrentSpec }}>
            {isCurrentSpec && <aside class="spec-index" aria-label="On this page"><p>On this page</p><ol>{specSections.map(([label, id]) => <li><a href={`#${id}`}>{label}</a></li>)}</ol><a class="spec-index-top" href="#top">Back to top ↑</a></aside>}
            {isCurrentSpec && <details class="spec-mobile-index"><summary>On this page <span aria-hidden="true">+</span></summary><ol>{specSections.map(([label, id]) => <li><a href={`#${id}`}>{label}</a></li>)}</ol></details>}
            <article class:list={{ "spec-document": isCurrentSpec }} id={isCurrentSpec ? "top" : undefined}><slot /></article>
        </div>
    </main>
    <footer>
        &copy; 2026 &middot; BCP is an open standard maintained by Encoded Brands.
        <br/><br/>
        <a href="https://github.com/Brand-Context-Protocol/spec" style="color:inherit">Source on GitHub</a> &middot; <a href="https://encodedbrands.ai" style="color:inherit">encodedbrands.ai</a> &middot; <a href="/registry-verification" style="color:inherit">Verify the Reference Registry</a> &middot; <a href="https://smithery.ai/servers/encodedbrands/bcp-registry" style="color:inherit">Smithery Record</a>
    </footer>
</body>
</html>
